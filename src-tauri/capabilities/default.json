{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the WarpGen main window: run the warpscout sidecar, make HTTP requests (Cloudflare API / DoH / proxy checks) and touch the app-data dir.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:path:default",
    "core:event:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/warpscout",
          "sidecar": true,
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.cloudflareclient.com/*" },
        { "url": "https://cloudflare-dns.com/*" },
        { "url": "https://dns.google/*" },
        { "url": "http://cp.cloudflare.com/*" },
        { "url": "https://cp.cloudflare.com/*" },
        { "url": "https://*/*" },
        { "url": "http://*/*" }
      ]
    },
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$DOWNLOAD/**" }, { "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }]
    }
  ]
}
